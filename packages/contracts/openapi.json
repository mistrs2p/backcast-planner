        "description": "Return the calendar's events, earliest start first.",
        "operationId": "listCalendarEvents",
        "parameters": [
          {
            "name": "calendar_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
