  "components": {
    "schemas": {
      "BackcastCreate": {
        "properties": {
          "current_narrative": {
            "type": "string",
            "title": "Current Narrative"
          },
          "future_description": {
            "type": "string",
            "title": "Future Description"
          },
          "target_date": {
            "type": "string",
            "format": "date-time",
            "title": "Target Date"
          },
          "gap_narrative": {
            "type": "string",
            "title": "Gap Narrative",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "current_narrative",
          "future_description",
          "target_date"
        ],
        "title": "BackcastCreate"
      },
      "BackcastResponse": {
        "properties": {
          "current": {
            "$ref": "#/components/schemas/CurrentStateResponse"
          },
          "future": {
            "$ref": "#/components/schemas/FutureStateResponse"
          },
          "gap": {
            "$ref": "#/components/schemas/GapResponse"
          },
          "run": {
            "$ref": "#/components/schemas/RunResponse"
          }
        },
        "type": "object",
        "required": [
          "current",
          "future",
          "gap",
          "run"
        ],
        "title": "BackcastResponse",
        "description": "The intent layer of one goal's backcast, as the UI\nvisualizes it: current → gap → future, and the pipeline run\nexecuting over that context."
      },
      "CalendarCreate": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "CalendarCreate"
      },
      "CalendarResponse": {
        "properties": {
          "calendar_id": {
            "type": "string",
            "format": "uuid",
            "title": "Calendar Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "calendar_id",
          "user_id",
          "timezone",
          "created_at",
          "updated_at"
        ],
        "title": "CalendarResponse"
      },
      "ConflictResponse": {
        "properties": {
          "first": {
            "$ref": "#/components/schemas/EventResponse"
          },
          "second": {
            "$ref": "#/components/schemas/EventResponse"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          }
        },
        "type": "object",
